generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model EvidenceSnapshot {
  id            String   @id @default(cuid())
  prNumber      Int
  repoFullName  String
  headSha       String
  evidenceType  String
  changedFiles  String
  diffStats     String?
  reviewComments String?
  checkStatuses String?
  prTitle       String?
  prBody        String?
  rawPayload    String?
  createdAt     DateTime @default(now())

  decisions     DecisionRecord[]
}

model DecisionRecord {
  id                String            @id @default(cuid())
  decisionId        String            @unique
  prNumber          Int
  repoFullName      String
  mergeCommitSha    String
  author            String?
  prTitle           String?
  prBody            String?
  createdAt         DateTime          @default(now())

  evidenceSnapshots EvidenceSnapshot[]
}

model DecisionDAGEdge {
  id              String   @id @default(cuid())
  repoFullName    String
  parentPrNumber  Int
  childPrNumber   Int
  sharedFiles     String
  fileCount       Int
  reason          String   @default("file_overlap")
  satisfied       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([repoFullName, parentPrNumber, childPrNumber])
}

model ConflictDetection {
  id              String   @id @default(cuid())
  repoFullName    String
  prNumberA       Int
  prNumberB       Int
  sharedFiles     String
  fileCount       Int
  severity        String   @default("warning")
  detectedAt      DateTime @default(now())
  resolvedAt      DateTime?
  resolution      String?

  @@unique([repoFullName, prNumberA, prNumberB])
}