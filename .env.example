# EvoGuard — Environment Variables Example
# Copy this file to `.env` and fill in your values.
# For Vercel deployment, add these as Environment Variables in your Vercel project settings.
#
# For self-hosting: see DEPLOYMENT.md for the full setup guide.

# ─────────────────────────────────────────────────────────────────────────────
# Demo / Marketing Site (this repository)
# ─────────────────────────────────────────────────────────────────────────────
# No environment variables required — all mock data is bundled in
# src/lib/evoguard/mock-data.ts

# ─────────────────────────────────────────────────────────────────────────────
# Production Backend (when available — not part of this repo)
# ─────────────────────────────────────────────────────────────────────────────
# Uncomment the variables below when wiring up the production backend.

# Database (PostgreSQL connection string)
# DATABASE_URL="postgresql://user:password@localhost:5432/evoguard?schema=public"

# GitHub App credentials (see https://docs.github.com/en/developers/apps/building-github-apps)
# GITHUB_APP_ID="your-app-id"
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_WEBHOOK_SECRET="your-webhook-secret"
# GITHUB_CLIENT_ID="your-client-id"
# GITHUB_CLIENT_SECRET="your-client-secret"

# LLM Provider
# LLM_PROVIDER="openai"          # openai | anthropic | self-hosted
# LLM_API_KEY="sk-..."
# LLM_MODEL="gpt-4-turbo-preview"

# Encryption (per-tenant keys)
# ENCRYPTION_KEY="32-byte-hex-key-for-aes-256"
# JWT_SECRET="your-jwt-secret-min-32-chars"

# Optional — for enterprise self-hosted only
# CUSTOM_LLM_BASE_URL="https://your-llm-endpoint/v1"
# REDIS_URL="redis://localhost:6379"
# BULLMQ_REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────────────────────────────────────
# Vercel Deployment (for GitHub Actions — vercel-deploy.yml)
# ─────────────────────────────────────────────────────────────────────────────
# These three secrets are only needed if you want automated Vercel deploys
# from GitHub Actions. See DEPLOYMENT.md for setup instructions.
#
# Add them to your GitHub repository under:
#   Settings → Secrets and variables → Actions → New repository secret
#
# VERCEL_TOKEN=""           # Create at https://vercel.com/account/tokens
# VERCEL_ORG_ID=""          # Find in your Vercel project: Settings → General
# VERCEL_PROJECT_ID=""      # Find in your Vercel project: Settings → General

# ─────────────────────────────────────────────────────────────────────────────
# Next.js / Vercel (auto-configured)
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_TELEMETRY_DISABLED=1
